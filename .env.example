POSTGRES_USER=whattspoppin
POSTGRES_PASSWORD=muda-me
POSTGRES_DB=whattspoppin
POSTGRES_PORT=5432

DATABASE_URL=postgresql+pool://whattspoppin:muda-me@localhost:5432/whattspoppin

# Domínio dos identificadores user@domínio deste servidor (em produção, o
# domínio público). Os dois servidores de dev (backend/dev/) definem o seu.
SERVER_NAME=localhost:8000

# BD só para o pytest (o nome tem de acabar em _test) - criar com:
# docker exec -it whattspoppin-postgres createdb -U whattspoppin whattspoppin_test
TEST_DATABASE_URL=postgresql+pool://whattspoppin:muda-me@localhost:5432/whattspoppin_test
